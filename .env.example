# Required in production: a long random string used to sign login cookies.
# `npm install` creates .env.local with one for you. To make your own:  openssl rand -hex 32
SESSION_SECRET=

# Optional: send real SMS and WhatsApp through Twilio. Without these, messages are logged and marked "simulated".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1xxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional: public URL of /api/twilio/inbound, used to verify Twilio's signature on patient replies
TWILIO_WEBHOOK_URL=

# Optional: where the SQLite file lives (default ./data)
DATA_DIR=
